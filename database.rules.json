{
  "rules": {
    ".read": false,
    ".write": false,
    "rooms": {
      "$code": {
        ".read": true,
        ".write": true,
        ".validate": "$code.matches(/^[0-9]{4}$/)"
      }
    },
    "rooms167": {
      "$code": {
        ".read": true,
        ".write": true,
        ".validate": "$code.matches(/^[0-9]{4}$/)"
      }
    },
    "rooms170": {
      "$code": {
        ".read": true,
        ".write": true,
        ".validate": "$code.matches(/^[0-9]{4}$/)"
      }
    },
    "admins": {
      ".read": "auth != null",
      "$uid": {
        ".write": "auth != null && auth.uid === $uid && !root.child('admins').exists()"
      }
    },
    "players": {
      ".read": "auth != null && root.child('admins').child(auth.uid).exists()",
      "$id": {
        ".write": "$id.matches(/^[a-z0-9]{12}$/)",
        ".validate": "newData.hasChildren(['last'])"
      }
    },
    "online": {
      ".read": "auth != null && root.child('admins').child(auth.uid).exists()",
      "$id": {
        ".write": "$id.matches(/^[a-z0-9]{12}$/)"
      }
    }
  }
}
